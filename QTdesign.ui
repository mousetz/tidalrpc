  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget {
    background: #0b0b0d;
    color: #f5f5f7;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QLabel, QCheckBox {
    background: transparent;
}
QLabel#titleLabel {
    font-size: 22pt;
    font-weight: 700;
}
QLabel#subtitleLabel, QLabel#artistLabel {
    color: #a7a7ad;
}
QLabel#trackLabel {
    font-size: 15pt;
    font-weight: 600;
}
QLabel#overallStatusLabel {
    color: #b7b7bd;
    padding: 2px 0;
}
QLabel#overallStatusLabel[state="error"] {
    color: #ff7777;
}
QFrame#statusCard, QGroupBox {
    background: #151519;
    border: 1px solid #29292f;
    border-radius: 10px;
}
QGroupBox {
    font-weight: 600;
    margin-top: 10px;
    padding-top: 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}
QLabel#tidalStatusLabel, QLabel#rpcStatusLabel {
    border-radius: 8px;
    padding: 4px 9px;
    font-size: 9pt;
    font-weight: 600;
}
QLabel[state="connected"] {
    background: #123b2b;
    color: #72e6ae;
}
QLabel[state="paused"], QLabel[state="waiting"], QLabel[state="missing"] {
    background: #303038;
    color: #c7c7cd;
}
QLabel[state="disabled"] {
    background: #27272d;
    color: #8c8c94;
}
QLabel[state="error"] {
    background: #442326;
    color: #ff8b91;
}
QCheckBox {
    spacing: 9px;
    padding: 5px 0;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
}
QCheckBox::indicator:unchecked {
    border: 1px solid #55555d;
    border-radius: 5px;
    background: #202025;
}
QCheckBox::indicator:checked {
    border: 1px solid #28a7ff;
    border-radius: 5px;
    background: #129cff;
}
QCheckBox:disabled {
    color: #6f6f76;
}
QPushButton {
    background: #f5f5f7;
    color: #101013;
    border: 0;
    border-radius: 7px;
    padding: 8px 14px;
    font-weight: 600;
}
QPushButton:hover {
    background: #dcdce1;
}
QPushButton:pressed {
    background: #c8c8ce;
}
QStatusBar {
    background: #0b0b0d;
}</string>
